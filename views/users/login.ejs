<% layout("layout/boilerplate") %>

<!-- ERROR FLASH -->
<% if (error && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong><%= error[0] %></strong>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="alert"
            aria-label="Close">
        </button>
    </div>
<% } %>

<!-- LOGIN FORM -->
<div class="row justify-content-center mt-lg-4">
    <div class="col-lg-10 col-xl-9">

        <div class="wl-auth-card">
            <div class="row g-0">

                <!-- Side panel -->
                <div class="col-md-5 d-none d-md-block">
                    <div class="wl-auth-aside h-100">
                        <span class="wl-brand-mark"><i class="fa-regular fa-compass"></i></span>
                        <h2>Good to see you again</h2>
                        <p>Log in to list your place and leave reviews.</p>
                    </div>
                </div>

                <!-- Form -->
                <div class="col-md-7">
                    <div class="p-4 p-md-5">

                        <h1 class="h3 mb-4">Welcome Back to Wanderlust</h1>

                        <form
                            action="/login"
                            method="POST"
                            class="needs-validation"
                            novalidate
                        >

                            <!-- Username -->
                            <div class="mb-3">
                                <label for="username" class="form-label">
                                    Username
                                </label>

                                <div class="input-group has-validation">
                                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                                    <input
                                        type="text"
                                        class="form-control"
                                        id="username"
                                        name="username"
                                        placeholder="Enter your username"
                                        required
                                    >

                                    <div class="invalid-feedback">
                                        Please enter your username.
                                    </div>
                                </div>
                            </div>

                            <!-- Password -->
                            <div class="mb-4">
                                <label for="password" class="form-label">
                                    Password
                                </label>

                                <div class="input-group has-validation">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input
                                        type="password"
                                        class="form-control"
                                        id="password"
                                        name="password"
                                        placeholder="Enter your password"
                                        required
                                    >

                                    <div class="invalid-feedback">
                                        Please enter your password.
                                    </div>
                                </div>
                            </div>

                            <!-- Login Button -->
                            <button
                                type="submit"
                                class="btn btn-primary rounded-pill px-4 w-100"
                            >
                                Login
                            </button>

                        </form>

                        <p class="mt-4 mb-0 text-body-secondary">
                            Don't have an account?
                            <a href="/signup" class="fw-semibold">Sign up here</a>
                        </p>

                    </div>
                </div>

            </div>
        </div>

    </div>
</div>
